# =====================================================================
# NSCI Sports Desk OS - environment variables
# Copy this file to .env.local (for your computer) and fill in the values.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.
# NEVER commit .env.local. Only this example file belongs in Git.
# =====================================================================

# --- Supabase (required) ---------------------------------------------
# Supabase -> Project Settings -> API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. Safe for the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. SERVER ONLY. Used by n8n automation and WhatsApp endpoints.
# Never prefix with NEXT_PUBLIC_. Optional until you set up n8n.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (optional, for Sports Desk AI) ----------------------------
# platform.openai.com -> API keys. Without it the assistant runs in "basic mode".
OPENAI_API_KEY=
# Any current chat model that supports tool/function calling.
OPENAI_MODEL=gpt-4.1-mini

# --- Automation (n8n) -------------------------------------------------
# A long random string (at least 32 characters). n8n sends it as: Authorization: Bearer <value>
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_SECRET=

# Public URL of the app (used in docs/n8n), e.g. https://nsci-sports-desk.vercel.app
APP_URL=http://localhost:3000

# --- WhatsApp Cloud API (later) ---------------------------------------
# Leave empty until you set up WhatsApp (docs/WHATSAPP.md). The webhook stays off while any are empty.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated numbers allowed to use the bot, digits only, with country code: 919876543210,919812345678
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_GRAPH_VERSION=v21.0
